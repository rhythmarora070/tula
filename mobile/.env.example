# Copy to .env.local (git-ignored) for local development.
# Values: Supabase dashboard > Project Settings > API keys. Use the publishable key (sb_publishable_...),
# never a secret key. Cloud builds don't read this file: set the same names as EAS environment
# variables instead (see README).
# Leave both empty and the app runs fully on the phone, reading notices with plain code.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
